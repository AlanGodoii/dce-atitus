# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3333
API_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173

# Outras origens autorizadas a chamar a API (lista separada por vírgula).
# Em produção serve para liberar a variante com "www" do site.
CORS_ORIGENS=

# Onde ficam fotos, carteirinhas e comprovantes. Em desenvolvimento fica em
# branco (usa a pasta do backend); em produção aponta para o volume persistente.
DADOS_DIR=

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dce_atitus?schema=public"

# ---------------------------------------------------------------------------
# Autenticacao
# Gere um segredo forte com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Checagem de MX do dominio no cadastro (deixe false se a rede bloquear DNS)
VALIDAR_DOMINIO_EMAIL=true

# ---------------------------------------------------------------------------
# Google OAuth (console.cloud.google.com > APIs e servicos > Credenciais)
# URI de redirecionamento autorizada: http://localhost:3333/auth/google/callback
# Deixe em branco para desabilitar o login social.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback

# ---------------------------------------------------------------------------
# Dados do DCE (exibidos na landing e na tela de pagamento)
# ---------------------------------------------------------------------------
DCE_NOME="DCE ATITUS"
# Nome oficial do diretório. Vai impresso no verso da carteirinha e nos textos
# do site. É a fonte única — mudar aqui muda em todo lugar.
DCE_NOME_COMPLETO="Diretório Central de Estudantes Matheus Teixeira"
DCE_INSTITUICAO="ATITUS"
DCE_CHAVE_PIX=09178125000180
DCE_TIPO_CHAVE_PIX=CNPJ
DCE_BENEFICIARIO_PIX="Diretório Central de Estudantes Matheus Teixeira"
DCE_VALOR_CARTEIRINHA=10
DCE_WHATSAPP=5554992368617
DCE_EMAIL=dce@atitus.edu.br

# Assinatura impressa no verso da carteirinha.
# Para usar a assinatura escaneada, salve a arte em src/assets/assinatura.png
# (fundo transparente, traço preto). Sem o arquivo, sai só a linha com o nome.
DCE_RESPONSAVEL_NOME=
DCE_RESPONSAVEL_CARGO="Presidente do DCE"

# ---------------------------------------------------------------------------
# E-mail (Brevo SMTP relay) - usado na etapa de envio da carteirinha
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="DCE ATITUS"
# Precisa ser um remetente VERIFICADO no Brevo, ou qualquer endereço de um
# domínio AUTENTICADO por DNS (nesse caso não precisa de caixa de e-mail).
SMTP_FROM_EMAIL=
# Para onde vão as respostas dos alunos. Necessário quando o remetente é um
# endereço de domínio autenticado sem caixa de e-mail associada.
SMTP_REPLY_TO=

# Interruptor geral de envio. Coloque false ANTES de rodar "npm run test:smoke":
# os testes cadastram alunos em e-mails fictícios, e enviar de verdade para
# caixas inexistentes gera bounce e derruba a reputação do remetente no Brevo.
EMAIL_ENVIO_ATIVO=true

# ---------------------------------------------------------------------------
# Admin inicial criado pelo seed
# ---------------------------------------------------------------------------
ADMIN_NOME="Daniel Cavalheiro"
ADMIN_EMAIL=admin@dceatitus.com.br
ADMIN_SENHA=trocar123
