# ---------------------------------------------------------------------------
# Produção — VPS.
#
# Copie para .env NO SERVIDOR e preencha:   cp .env.example .env
#
# Dois usos ao mesmo tempo: o docker compose lê daqui para montar os serviços,
# e o mesmo arquivo é entregue à API como variáveis de ambiente.
#
# NUNCA versione o .env preenchido — ele tem a senha do banco, o segredo do JWT
# e a chave de e-mail. O .gitignore já bloqueia, mas confira antes de commitar.
#
# Não use aspas nos valores. Espaços funcionam sem elas, e aspas correm o risco
# de aparecerem literalmente para o aluno (o nome do beneficiário do PIX, por
# exemplo, é lido direto pelo app do banco).
# ---------------------------------------------------------------------------

# --- Domínios --------------------------------------------------------------
DOMINIO=dcematheusteixeira.com.br
DOMINIO_API=api.dcematheusteixeira.com.br

# Para onde a Let's Encrypt avisa se um certificado falhar em renovar. Use um
# e-mail que alguém realmente lê — certificado vencido derruba o site inteiro,
# inclusive a validação por QR Code.
#
# Já vem preenchido de propósito: o Caddy NÃO SOBE se este campo ficar vazio,
# e descobrir isso no meio do deploy custa caro.
ACME_EMAIL=dce@atitus.edu.br

# Endereços públicos usados pelo backend. Ficam GRAVADOS dentro da imagem do QR
# Code no momento da emissão: carteirinha emitida com endereço errado tem o QR
# quebrado para sempre. Conferir antes da primeira emissão real.
API_URL=https://api.dcematheusteixeira.com.br
FRONTEND_URL=https://dcematheusteixeira.com.br

# O www redireciona para o domínio principal no Caddy, então não há uma segunda
# origem chamando a API. Deixe em branco.
CORS_ORIGENS=

# --- Banco de dados --------------------------------------------------------
POSTGRES_USER=dce_atitus
POSTGRES_DB=dce_atitus
# Gere no servidor:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Autenticação ----------------------------------------------------------
# Gere no servidor:  openssl rand -hex 48
# Trocar depois desloga todos os alunos e o admin de uma vez.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Checagem de MX do domínio no cadastro.
VALIDAR_DOMINIO_EMAIL=true

# --- Dados do DCE ----------------------------------------------------------
DCE_NOME=DCE ATITUS
# Nome oficial do diretório. Vai impresso no verso da carteirinha e nos textos
# do site. É a fonte única — mudar aqui muda em todo lugar.
DCE_NOME_COMPLETO=Diretório Central de Estudantes Matheus Teixeira
DCE_INSTITUICAO=ATITUS
DCE_CHAVE_PIX=09178125000180
DCE_TIPO_CHAVE_PIX=CNPJ
DCE_BENEFICIARIO_PIX=Diretório Central de Estudantes Matheus Teixeira
DCE_VALOR_CARTEIRINHA=10
DCE_WHATSAPP=5554992368617
DCE_EMAIL=dce@atitus.edu.br

# Impresso no verso da carteirinha, sobre a linha de assinatura. Decidido em
# 02/08/2026: só o nome digitado, sem assinatura escaneada. Se um dia quiserem a
# arte escaneada, basta salvar em backend/src/assets/assinatura.png (fundo
# transparente, traço preto) — o template a usa sozinho quando o arquivo existe.
DCE_RESPONSAVEL_NOME=Daniel Cavalheiro
DCE_RESPONSAVEL_CARGO=Presidente do DCE

# --- E-mail (Brevo SMTP relay) ---------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=DCE ATITUS
# Precisa ser um remetente VERIFICADO no Brevo, ou qualquer endereço de um
# domínio AUTENTICADO por DNS — neste segundo caso não é preciso existir caixa
# de e-mail nenhuma nesse endereço.
SMTP_FROM_EMAIL=dce@dcematheusteixeira.com.br
# Para onde vão as respostas dos alunos. Necessário justamente porque o
# remetente acima é um endereço sem caixa.
SMTP_REPLY_TO=dce@atitus.edu.br

# Interruptor geral de envio.
EMAIL_ENVIO_ATIVO=true

# --- Login com Google ------------------------------------------------------
# Desligado. Preencher só se um dia for usado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.dcematheusteixeira.com.br/auth/google/callback

# --- Admin inicial (criado pelo seed) --------------------------------------
ADMIN_NOME=Daniel Cavalheiro
ADMIN_EMAIL=
# Senha provisória, trocada no primeiro acesso.
ADMIN_SENHA=

# --- Backup ----------------------------------------------------------------
BACKUP_DIR=/var/backups/dce
BACKUP_RETENCAO_DIAS=14
